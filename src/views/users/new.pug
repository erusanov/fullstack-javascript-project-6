extends ../layouts/application

block content
  h1.display-4.fw-bold.mt-4= t('views.users.new')

  .row.justify-content-center
    .col-12.col-md-8
      .card.shadow-sm
        .card-body.row.p-5
          .col-12.col-md-6.d-flex.align-items-center.justify-content-center
            img.rounded-circle(src='/assets/avatar_1-D7Cot-zE.jpg' alt='avatar')
          .col-12.col-md-6.mt-3.mt-mb-0
            form(action=app.reverse(ROUTES.USERS_CREATE.NAME) method='post')
              .mb-3.form-floating
                input.form-control(type='text' id='data_firstName' name='data[firstName]' value=user.firstName class=(errors && errors.firstName ? 'is-invalid' : ''))
                label.form-label(for='data_firstName')= t('views.users.firstName')
                if errors && errors.firstName
                  div.invalid-feedback= errors.firstName.message
              .mb-3.form-floating
                input.form-control(type='text' id='data_lastName' name='data[lastName]' value=user.lastName class=(errors && errors.lastName ? 'is-invalid' : ''))
                label.form-label(for='data_lastName')= t('views.users.lastName')
                if errors && errors.lastName
                  div.invalid-feedback= errors.lastName.message
              .mb-3.form-floating
                input.form-control(type='email' id='data_email' name='data[email]' value=user.email class=(errors && errors.email ? 'is-invalid' : ''))
                label.form-label(for='data_email')= t('views.users.email')
                if errors && errors.email
                  div.invalid-feedback= errors.email.message
              .mb-3.form-floating
                input.form-control(type='password' id='data_password' name='data[password]' class=(errors && errors.password ? 'is-invalid' : ''))
                label.form-label(for='data_password')= t('views.users.password')
                if errors && errors.password
                  div.invalid-feedback= errors.password.message
              button.btn.btn-primary(type='submit')= t('views.users.register')
