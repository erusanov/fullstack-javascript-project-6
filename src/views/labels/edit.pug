extends ../layouts/application

block content
  .container.mt-3
    h1= t('views.label.editLabel')

    form(action=app.reverse(ROUTES.LABELS_UPDATE.NAME, { id: label.id }) method='post')
      input(type="hidden" name="_method" value="patch")
      .mb-3
        label.form-label(for='data_name')= t('views.label.name')
        input.form-control(type='text' id='data_name' name='data[name]' value=label.name class=(errors && errors.name ? 'is-invalid' : ''))
        if errors && errors.name
          div.invalid-feedback= errors.name.message
      button.btn.btn-primary(type='submit')= t('views.label.edit')
