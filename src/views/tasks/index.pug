extends ../layouts/application

block content
  h1.display-4.fw-bold.mt-4= t('views.task.tasks')
  a.btn.btn-primary(href=app.reverse(ROUTES.TASKS_NEW.NAME))= t('views.task.new')

  .card.shadow-sm.mt-4
    .card-body.p-4
      form(action=app.reverse(ROUTES.TASKS.NAME) method='get')
        .row
          .col-12.col-md
            .input-group.mb-3
              label.input-group-text(for='data_status')= t('views.task.filter.status')
              select.form-select(id='data_status' name='statusId')
                option(value="")
                each status in statuses
                  option(value=status.id selected=filter.statusId == status.id)= status.name
          .col-12.col-md
            .input-group.mb-3
              label.input-group-text(for='data_executor')= t('views.task.filter.executor')
              select.form-select(id='data_executor' name='executorId')
                option(value="")
                each user in users
                  option(value=user.id selected=filter.executorId == user.id)= `${user.firstName} ${user.lastName}`
          .col-12.col-md
            .input-group.mb-3
              label.input-group-text(for='data_label')= t('views.task.filter.label')
              select.form-select(id='data_label' name='labelId')
                option(value="")
                each label in labels
                  option(value=label.id selected=filter.labelId == label.id)= label.name
        .mb-3.form-check
          input.form-check-input(id='data_isCreatorUser' type='checkbox' name='isCreatorUser' checked=filter.isCreatorUser)
          label.form-check-label(for='data_isCreatorUser')= t('views.task.filter.showMyTasks')
        input.btn.btn-primary(type='submit' value=t('views.task.filter.apply'))

  .table-responsive
    table.table.table-borderless.table-striped.mt-5.bg-white
      thead
        tr
          th= t('views.task.id')
          th= t('views.task.name')
          th= t('views.task.status')
          th= t('views.task.creator')
          th= t('views.task.executor')
          th= t('views.task.createdAt')
          th= t('views.task.actions')
      tbody
        each task in tasks
          tr
            td= task.id
            td
              a(href=app.reverse(ROUTES.TASKS_VIEW.NAME, { id: task.id }))= task.name
            td= task.status ? task.status.name : ''
            td= `${task.creator.firstName} ${task.creator.lastName}`
            td= task.executor ? `${task.executor.firstName} ${task.executor.lastName}` : ''
            td= task.createdAt
            td
              .d-flex.flex-wrap
                a.btn.btn-primary.me-1(href=app.reverse(ROUTES.TASKS_EDIT.NAME, { id: task.id }))= t('views.task.edit')
                form(action=app.reverse(ROUTES.TASKS_DELETE.NAME, { id: task.id }) method='post')
                  input(type="hidden" name="_method" value="delete")
                  button.btn.btn-danger(type="submit")= t('views.task.delete')
