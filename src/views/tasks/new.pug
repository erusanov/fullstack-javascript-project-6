extends ../layouts/application

block content
  .container.mt-3
    h1= t('views.task.new')

    form(action=app.reverse(ROUTES.TASKS_CREATE.NAME) method='post')
      .mb-3
        label.form-label(for='data_name')= t('views.task.name')
        input.form-control(type='text' id='data_name' name='data[name]' value=task.name)
        if errors && errors.name
          .text-danger= errors.name.message
      .mb-3
        label.form-label(for='data_description')= t('views.task.description')
        textarea.form-control(id='data_description' name='data[description]')= task.description
      .mb-3
        label.form-label(for='data_statusId')= t('views.task.status')
        select.form-select(id='data_statusId' name='data[statusId]' class=(errors && errors.statusId ? 'is-invalid' : ''))
          option(value="")
          each status in statuses
            option(value=status.id selected=task.statusId === status.id)= status.name
        if errors && errors.statusId
          each error in errors.statusId
            .text-danger= error.message
      .mb-3
        label.form-label(for='data_executorId')= t('views.task.executor')
        select.form-select(id='data_executorId' name='data[executorId]')
          option(value="")
          each user in users
            option(value=user.id selected=task.executorId === user.id)= `${user.firstName} ${user.lastName}`
      .mb-3
        label.form-label(for='data_labels')= t('views.task.labels')
        select.form-select(id='data_labels' name='data[labels]' multiple)
          - const selectedLabels = [].concat(task.labels || []).map(l => l.id || l)
          each label in labels
            option(value=label.id selected=selectedLabels.includes(label.id))= label.name
      button.btn.btn-primary(type='submit')= t('views.task.create')
