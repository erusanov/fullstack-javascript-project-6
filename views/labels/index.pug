extends ../layouts/application.pug

block content
  h1.display-4.fw-bold.mt-4= t('views.label.labels')
  a.btn.btn-primary(href=app.reverse('labelsNew'))= t('views.label.new')

  .table-responsive
    table.table.table-borderless.table-striped.mt-5.bg-white
      thead
        tr
          th= t('views.label.id')
          th= t('views.label.name')
          th= t('views.label.createdAt')
          th= t('views.label.actions')
      tbody
        each label in labels
          tr
            td= label.id
            td= label.name
            td= label.createdAt
            td
              .d-flex.flex-wrap
                a.btn.btn-primary.me-1(href=app.reverse('labelsEdit', { id: label.id }))= t('views.label.edit')
                form(action=app.reverse('labelsDelete', { id: label.id }) method='post')
                  input(type="hidden" name="_method" value="delete")
                  button.btn.btn-danger(type="submit")= t('views.label.delete')
